# ---------------------------------------------------------------------------
# Personal AI-Powered APM System — .gitignore
# Stack: Node.js + TypeScript (insight-service), React + TypeScript (dashboard),
#        Docker Compose, Prometheus, Grafana. Single-user, $0/month.
# ---------------------------------------------------------------------------

# --- Node.js / npm / yarn / pnpm ---
node_modules/
.pnp
.pnp.js
.npm
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- TypeScript build output ---
dist/
build/
out/
*.tsbuildinfo
services/insight-service/dist/
dashboard/dist/
dashboard/build/

# --- React / Vite / bundler caches ---
.vite/
.cache/
.parcel-cache/
coverage/
.nyc_output/

# --- Environment & secrets (keep the $0 guardrail: never commit LLM API keys) ---
# Gemini / Groq keys, webhook URLs, and any local overrides
.env
.env.*
!.env.example
*.local

# --- Docker / Compose runtime overrides ---
docker-compose.override.yml
docker-compose.*.local.yml

# --- Prometheus persisted TSDB data (metrics volume, not source) ---
prometheus/data/
prometheus-data/

# --- Grafana persisted data (db, sessions, plugins) — provisioning stays tracked ---
grafana/data/
grafana-data/
grafana/grafana.db

# --- Ollama local models (large, machine-local) ---
.ollama/
ollama-models/

# --- Test / tooling artifacts ---
*.lcov
.eslintcache
.stylelintcache
.vitest/
playwright-report/
test-results/

# --- OS files ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editor / IDE ---
.idea/
*.swp
*.swo
*~
# VS Code: keep shareable settings, ignore per-user workspace state
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# --- Kiro: keep specs & steering tracked (they ARE your progress artifacts) ---
# Ignore only local/transient Kiro state, not the spec docs.
.kiro/**/*.log

# --- Kiro specs kept local (not shared to the repo) ---
.kiro/
